@{
    ViewData["Title"] = "Edit Blog";
}

<input type="hidden" id="txtId" name="txtId" value="@ViewBag.BlogId" />

<div class="mb-3">
    <label class="form-label">Title</label>
    <input type="text" class="form-control" name="txtTitle" id="txtTitle" >
</div>
<div class="mb-3">
    <label class="form-label">Author</label>
    <input type="text" class="form-control" name="txtAuthor" id="txtAuthor">
</div>
<div class="mb-3">
    <label class="form-label">Content</label>
    <textarea class="form-control" id="txtContent" name="txtContent" rows="3"></textarea>
</div>
<a href="/blogajax" class="btn btn-secondary">Cancel</a>
<button type="button" class="btn btn-primary" id="btnUpdate">Update</button>

@section scripts {
    <script>
        $(document).ready(function () {
          
            const blogId = $('#txtId').val();
            $.ajax({
                url: `/BlogAjax/EditData/${blogId}`,
                type: "GET",
                success: function (response) {
                    if(response.Data)
                    {
                       
                    $('#txtTitle').val(response.Data.BlogTitle);
                    $('#txtAuthor').val(response.Data.Author);
                    $('#txtContent').val(response.Data.Content);
                    }
                    else{
                        alert(response.Message);
                    }
                    
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                }
            });
        

        $('#btnUpdate').click(function () {
           const blogId = $('#txtId').val();
            const blogData = {
                //BlogId: $('#txtId').val(),
                BlogTitle: $('#txtTitle').val(),
                BlogAuthor: $('#txtAuthor').val(),
                BlogContent: $('#txtContent').val()
            };

            $.ajax({
                url: `/BlogAjax/Update/${blogId}`,
                type: "POST",
                data: blogData,
                success: function (response) {
                    alert(response.Message);
                    if (response.IsSuccess) {
                        window.location.href = "/BlogAjax";
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                }
            });
        });
        });
    </script>
}