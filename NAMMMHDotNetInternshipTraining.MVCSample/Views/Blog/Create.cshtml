<form action="/blog/save" method="post">
    <div class="mb-3">
        <label for="BlogTitle" class="form-label">Blog Title</label>
        <input type="text" class="form-control" id="BlogTitle" name="BlogTitle" placeholder="Enter blog title here">
    </div>

    <div class="mb-3">
        <label for="BlogAuthor" class="form-label">Author Name</label>
        <input type="text" class="form-control" id="BlogAuthor" name="BlogAuthor" placeholder="Enter author name">
    </div>

    <div class="mb-3">
        <label for="BlogContent" class="form-label">Blog Content</label>
        <textarea class="form-control" id="BlogContent" name="BlogContent" rows="5" placeholder="Write your blog content here..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
